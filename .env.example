# Copy to .env and fill in. Never commit .env.

# ASI:One LLM API key — https://asi1.ai
# Used for natural-language parsing inside each agent. Every agent degrades to a
# deterministic keyword parser if this is unset, so the system still works
# without it.
ASI_ONE_API_KEY=

# Agentverse API key — https://agentverse.ai/profile/api-keys
# Required for register_chat_agent() to publish each agent's profile/README so
# ASI:One can discover it. Without it agents still run, but stay undiscoverable.
AGENTVERSE_API_KEY=

# Agent seed phrases. A seed IS the agent's permanent identity — its address is
# derived deterministically from this string. Change a seed and you get a new
# agent that nothing can find at the old address. Generate your own before
# publishing anything you intend to keep.
NAVIGATION_SEED_PHRASE=ucsc-welcome-week-navigation-change-me
EVENTS_SEED_PHRASE=ucsc-welcome-week-events-change-me
CLUBS_SEED_PHRASE=ucsc-welcome-week-clubs-change-me
